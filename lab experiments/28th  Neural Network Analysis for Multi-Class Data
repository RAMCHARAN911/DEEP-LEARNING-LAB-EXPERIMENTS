# Experiment 28: Neural Network Analysis for Multi-Class Data
# Learning Rate = 0.001
# Activation = ReLU
# Hidden Layers = 3
# Hidden Neurons = 2 in each layer

import numpy as np
import matplotlib.pyplot as plt
from sklearn.datasets import make_blobs
from sklearn.model_selection import train_test_split
from sklearn.neural_network import MLPClassifier
from sklearn.metrics import accuracy_score, confusion_matrix, classification_report

# 1. Generate Multi-Class Dataset
X, y = make_blobs(
    n_samples=600,
    centers=4,
    n_features=2,
    cluster_std=1.5,
    random_state=42
)

# 2. Split dataset into training and testing
X_train, X_test, y_train, y_test = train_test_split(
    X, y,
    test_size=0.30,
    random_state=42,
    stratify=y
)

# 3. Create Neural Network
# 3 hidden layers with 2 neurons in each layer
model = MLPClassifier(
    hidden_layer_sizes=(2, 2, 2),
    activation='relu',
    learning_rate_init=0.001,
    max_iter=5000,
    random_state=42
)

# 4. Train the model
model.fit(X_train, y_train)

# 5. Prediction
y_pred = model.predict(X_test)

# 6. Calculate accuracy
accuracy = accuracy_score(y_test, y_pred)

print("=" * 60)
print("EXPERIMENT 28: NEURAL NETWORK FOR MULTI-CLASS DATA")
print("=" * 60)
print("Number of Classes   :", len(np.unique(y)))
print("Learning Rate       :", 0.001)
print("Activation Function :", "ReLU")
print("Hidden Layers       :", 3)
print("Neurons per Layer   :", 2)
print("Training Samples    :", len(X_train))
print("Testing Samples     :", len(X_test))
print("Accuracy            :", round(accuracy * 100, 2), "%")
print("Iterations          :", model.n_iter_)

# 7. Confusion Matrix
print("\nConfusion Matrix:")
print(confusion_matrix(y_test, y_pred))

# 8. Classification Report
print("\nClassification Report:")
print(classification_report(y_test, y_pred))

# 9. Plot original multi-class data
plt.figure(figsize=(8, 6))

plt.scatter(
    X[:, 0],
    X[:, 1],
    c=y,
    cmap='viridis',
    edgecolors='k',
    s=35
)

plt.title("Multi-Class Dataset")
plt.xlabel("Feature 1")
plt.ylabel("Feature 2")
plt.grid(True)
plt.show()

# 10. Create decision boundary
x_min, x_max = X[:, 0].min() - 1, X[:, 0].max() + 1
y_min, y_max = X[:, 1].min() - 1, X[:, 1].max() + 1

xx, yy = np.meshgrid(
    np.linspace(x_min, x_max, 500),
    np.linspace(y_min, y_max, 500)
)

grid = np.c_[xx.ravel(), yy.ravel()]

Z = model.predict(grid)
Z = Z.reshape(xx.shape)

# 11. Plot decision boundary
plt.figure(figsize=(8, 6))

plt.contourf(
    xx,
    yy,
    Z,
    alpha=0.25,
    cmap='viridis'
)

plt.scatter(
    X_test[:, 0],
    X_test[:, 1],
    c=y_test,
    cmap='viridis',
    edgecolors='k',
    s=40
)

plt.title("Neural Network Decision Boundary - Multi-Class Data")
plt.xlabel("Feature 1")
plt.ylabel("Feature 2")
plt.grid(True)
plt.show()

# 12. Training Loss Curve
plt.figure(figsize=(7, 5))

plt.plot(model.loss_curve_)

plt.title("Training Loss Curve")
plt.xlabel("Iterations")
plt.ylabel("Loss")
plt.grid(True)
plt.show()

# 13. Conclusion
print("\nConclusion:")
print("The neural network successfully classified the multi-class dataset.")
print("The model contains 3 hidden layers with 2 neurons in each layer.")
print("ReLU activation and a learning rate of 0.001 were used.")
print("The trained network learns the decision regions for the different classes.")
